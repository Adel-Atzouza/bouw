DSO_API_KEY=
DSO_ENVIRONMENT=production

# Public integration settings. Leave empty until the real services are available.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_SHOWROOM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Private server storage. Defaults to .data/intakes in this checkout.
# On the production server, point this at a persistent, backed-up disk outside public/.
INTAKE_STORAGE_DIR=

# Optional forwarding/email/CRM receiver. Requests are saved before forwarding.
# Without this connection, requests remain saved with delivery status "pending".
# The receiver must durably store requests, deduplicate Idempotency-Key, and return
# { "accepted": true, "reference": "<incoming reference>", "receivedAt": "<ISO timestamp>" }.
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_TOKEN=
